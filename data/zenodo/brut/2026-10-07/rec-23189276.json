/files/LLDH_V3_1_SUPPLEMENT_TH.zip/content"}}, {"id": "54cb1cf9-8b02-4984-affd-cc592104f614", "key": "LLDH_V3_1_DEPOT_02_SUR_05.zip", "size": 34646873, "checksum": "md5:0c466a56590831066d81ce8b6060bd2e", "links": {"self": "https://zenodo.org/api/records/23189276/files/LLDH_V3_1_DEPOT_02_SUR_05.zip/content"}}, {"id": "b223e4c6-b44d-4b8a-9f30-a2eee2581fb5", "key": "LLDH_V3_1_SUPPLEMENT_PT.zip", "size": 23620648, "checksum": "md5:80e26b3738eb12f62a641a2c97a7d915", "links": {"self": "https://zenodo.org/api/records/23189276/files/LLDH_V3_1_SUPPLEMENT_PT.zip/content"}}, {"id": "b547b2b7-8b1a-462c-b184-0e182c60393e", "key": "LLDH_V3_1_DEPOT_01_SUR_05.zip", "size": 37397331, "checksum": "md5:0b1a0a5ecb5e78ffd89145a5b0cbdd1a", "links": {"self": "https://zenodo.org/api/records/23189276/files/LLDH_V3_1_DEPOT_01_SUR_05.zip/content"}}], "swh": {}, "owners": [{"id": "1839585"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 9, "unique_views": 3, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 3, "version_views": 9}, "state": "done", "submitted": true}