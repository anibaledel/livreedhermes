# La Livrée d'Hermès — anibal-amiot.com
# P0-1 (audit SEO/GEO) : forcer HTTPS sur tout le site.
#
# Ce fichier ne prend effet que si l'hébergeur (gk2.net) sert le site via
# Apache avec mod_rewrite et AllowOverride activé pour ce répertoire — ce qui
# est le cas le plus courant en hébergement mutualisé, mais n'est pas garanti.
# Si la redirection ne fonctionne pas une fois déployée, demande à gk2.net :
#   "Merci de forcer une redirection 301 permanente de tout trafic HTTP vers
#   la version HTTPS du même chemin, pour anibal-amiot.com (et www si
#   applicable)."
# C'est l'équivalent, dans leur configuration serveur (nginx ou autre), de
# la règle ci-dessous.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# P0-3 (vérifié le 2026-09-05) : les directives "Redirect 301" (mod_alias)
# ci-dessous ont été testées en production et ne sont PAS honorées par gk2.net
# (les URLs répondaient 200, pas 301) — alors que le forçage HTTPS ci-dessus,
# qui utilise mod_rewrite, fonctionne bien. Remplacées par l'équivalent
# mod_rewrite, qui a le même effet mais passe par le module réellement actif
# sur cet hébergement. Les fichiers de transition (motifs (4).html,
# pages.html) restent en place comme repli HTML/JS si jamais cette règle
# cessait d'être honorée après un changement de configuration côté hébergeur.
<IfModule mod_rewrite.c>
  RewriteCond %{THE_REQUEST} \s/+motifs%20\(4\)\.html[\s?] [NC]
  RewriteRule ^ https://anibal-amiot.com/creation-motifs-yi-king.html [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+pages\.html[\s?] [NC]
  RewriteRule ^ https://anibal-amiot.com/fonds-ecran.html [R=301,L]

  # /index.html sert exactement le même contenu que / (DirectoryIndex Apache) :
  # on ne peut pas rediriger le fichier index.html lui-même (ça boucle avec /),
  # donc la condition ne matche que la requête brute "GET /index.html", jamais
  # la résolution interne de "/" vers index.html.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ https://anibal-amiot.com/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# P1 (audit SEO/GEO) : mise en cache des fichiers statiques.
# Ces règles ne prennent effet que si mod_headers est actif (quasi systématique
# sur l'hébergement mutualisé Apache). Si le cache ne s'applique pas une fois
# en ligne, demande à gk2.net les mêmes valeurs (voir résumé transmis par
# ailleurs pour le libellé exact à leur envoyer).
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# HSTS — NE PAS ACTIVER MAINTENANT.
# Une fois la redirection HTTPS ci-dessus validée en production (vérifier
# qu'aucune page ne casse en HTTPS, que les certificats sont bien en place),
# décommenter la ligne suivante pour indiquer aux navigateurs de toujours
# utiliser HTTPS pour ce domaine, sans même passer par la redirection :
#
# <IfModule mod_headers.c>
#   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
# </IfModule>
#
# Attention : une fois HSTS actif avec un max-age long, il est difficile de
# revenir en arrière rapidement (les navigateurs mémorisent la directive pour
# la durée indiquée) — ne l'activer qu'après avoir confirmé que HTTPS
# fonctionne correctement sur toutes les pages, y compris les PDF et assets.
